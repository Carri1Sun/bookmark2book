{
  "name": "tabbit-collections",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && tsx scripts/build-extension.ts",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts tests/*.test.tsx",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:extension": "tsx scripts/smoke-extension.ts",
    "format": "prettier --write src server shared scripts tests vite.config.ts"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "ipaddr.js": "^2.2.0",
    "jsdom": "^26.1.0",
    "lucide-react": "^0.468.0",
    "playwright": "^1.63.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.4",
    "undici": "^7.16.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.24",
    "@types/express": "^5.0.5",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "esbuild": "^0.25.12",
    "fake-indexeddb": "^6.2.5",
    "fflate": "^0.8.3",
    "prettier": "^3.9.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
